{
  "name": "mneme",
  "version": "0.1.0",
  "description": "A concept-centered learning layer for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:concept-memory": "node scripts/run-concept-memory-tests.mjs",
    "test:concept-queue": "node scripts/run-concept-queue-ranker-tests.mjs",
    "test:daily-review-eligibility": "node scripts/run-daily-review-eligibility-tests.mjs",
    "test:fsrs-retrievability": "node scripts/run-fsrs-retrievability-tests.mjs",
    "test:fsrs-scheduler": "node scripts/run-fsrs-scheduler-tests.mjs",
    "test:parser": "node scripts/run-card-marker-parser-tests.mjs",
    "test:review-queue": "node scripts/run-review-queue-tests.mjs",
    "test:scheduler": "node scripts/run-placeholder-scheduler-tests.mjs",
    "test:review-state": "node scripts/run-review-state-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "learning",
    "spaced-repetition",
    "fsrs"
  ],
  "author": "Linus",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "ts-fsrs": "^5.2.3",
    "zod": "^4.1.13"
  }
}
