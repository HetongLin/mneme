{
  "name": "mneme",
  "version": "1.0.1",
  "description": "A concept-centered learning layer for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check:release": "node scripts/check-release.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:concept-view-appender": "node scripts/run-concept-view-appender-tests.mjs",
    "test:concept-source-note-appender": "node scripts/run-concept-source-note-appender-tests.mjs",
    "test:concept-section-updater": "node scripts/run-concept-section-updater-tests.mjs",
    "test:concept-metadata-updater": "node scripts/run-concept-metadata-updater-tests.mjs",
    "test:ai-card-generation": "node scripts/run-ai-card-generation-tests.mjs",
    "test:ai-capture": "node scripts/run-ai-concept-capture-tests.mjs",
    "test:ai-provider": "node scripts/run-ai-provider-tests.mjs",
    "test:ai-schema": "node scripts/run-ai-schema-tests.mjs",
    "test:acceptance-fixture": "node scripts/run-acceptance-fixture-tests.mjs",
    "test:v1-core-loop": "node scripts/run-v1-core-learning-loop-tests.mjs",
    "test:concept-library": "node scripts/run-concept-library-tests.mjs",
    "test:concept-memory": "node scripts/run-concept-memory-tests.mjs",
    "test:concept-queue": "node scripts/run-concept-queue-ranker-tests.mjs",
    "test:concept-source-links": "node scripts/run-concept-source-link-tests.mjs",
    "test:daily-review-eligibility": "node scripts/run-daily-review-eligibility-tests.mjs",
    "test:fsrs-contract": "node scripts/run-fsrs-integration-contract-tests.mjs",
    "test:fsrs-retrievability": "node scripts/run-fsrs-retrievability-tests.mjs",
    "test:fsrs-scheduler": "node scripts/run-fsrs-scheduler-tests.mjs",
    "test:knowledge-proposals": "node scripts/run-knowledge-proposal-tests.mjs",
    "test:markdown-writer": "node scripts/run-markdown-writer-tests.mjs",
    "test:parser": "node scripts/run-card-marker-parser-tests.mjs",
    "test:card-editor": "node scripts/run-card-marker-editor-tests.mjs",
    "test:review-queue": "node scripts/run-review-queue-tests.mjs",
    "test:review-navigation": "node scripts/run-review-navigation-tests.mjs",
    "test:todays-focus": "node scripts/run-todays-focus-selector-tests.mjs",
    "test:user-facing-errors": "node scripts/run-user-facing-error-tests.mjs",
    "test:settings": "node scripts/run-settings-tests.mjs",
    "test:source-analysis": "node scripts/run-source-analysis-tests.mjs",
    "test:source-analysis-store": "node scripts/run-source-analysis-store-tests.mjs",
    "test:vault-state": "node scripts/run-vault-state-tests.mjs",
    "test:scheduler": "node scripts/run-placeholder-scheduler-tests.mjs",
    "test:review-state": "node scripts/run-review-state-tests.mjs",
    "test:release-metadata": "node scripts/run-release-metadata-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "learning",
    "spaced-repetition",
    "fsrs"
  ],
  "author": "Linus",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "ts-fsrs": "^5.2.3",
    "zod": "^4.1.13"
  }
}
